# ─────────────────────────────────────────────────────────────
# Janman Survey — environment template
# Copy to `.env.local` and fill in values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── App / Auth ───────────────────────────────────────────────
AUTH_SECRET=                       # openssl rand -base64 48
SESSION_MAX_AGE=604800             # session lifetime in seconds (7 days)

# ── MongoDB (source of truth) ────────────────────────────────
MONGODB_URI=
MONGODB_DB=janman_survey

# ── Cloudflare R2 (image storage) ────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=                       # https://<account>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=                # https://media.example (no trailing slash)

# ── Frappe (funder subset sync) ──────────────────────────────
FRAPPE_BASE_URL=https://patna.dignifiedlife.in
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
FRAPPE_USR=
FRAPPE_PWD=
FRAPPE_HOUSEHOLD_DOCTYPE=Household Detail

# ── First-run seed (initial Director) ────────────────────────
SEED_SECRET=
SEED_DIRECTOR_NAME=Shourya Roy
SEED_DIRECTOR_EMAIL=
SEED_DIRECTOR_PASSWORD=

# ── Scheduled jobs (vercel.json runs /api/cron/daily at 09:00 IST) ─
# Vercel sends this as "Authorization: Bearer <value>". Without it the job
# (monthly-report deadline reminders, Google Calendar retries) refuses to run.
CRON_SECRET=                       # openssl rand -base64 32

# ── Case closure approvals ───────────────────────────────────
# Who must approve before a case is verified and closed. A single rejection
# always sends the case back to the Community Mobiliser.
#   all        (default) Director, MIS and Programme Manager must each approve
#   any        one approval from any of the three
#   majority   approvals from two of the three roles
#   a list     e.g. programme_manager,mis  — each listed role must approve
CASE_CLOSURE_POLICY=all

# ── Google Calendar (camps) ──────────────────────────────────
# 1. Google Cloud: create a service account, enable "Google Calendar API",
#    download its JSON key.
# 2. In Google Calendar share the programme calendar with the service
#    account's client_email, permission "Make changes to events".
# 3. Fill these three from the key file / calendar settings. Leave empty to
#    keep camps working without calendar sync (they show "Calendar not connected").
GOOGLE_CALENDAR_ID=                # calendar ID, e.g. abc123@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=      # client_email from the key file
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=  # private_key from the key file (keep the \n escapes)
